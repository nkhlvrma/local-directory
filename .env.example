# Copy to .env.local and fill in values from your Supabase project
# https://supabase.com/dashboard/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Only needed for admin/server-side operations that bypass RLS
# NEVER expose this to the client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL (used for canonical/OG tags)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The single active city for this MVP (matches cities.slug in the DB)
NEXT_PUBLIC_CITY_SLUG=lucknow
